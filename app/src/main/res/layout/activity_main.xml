<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen spine:  top bar → orb (absorbs the leftover space) → chat + mic.
  Nothing is absolutely positioned, so nothing gets pushed off-screen on a
  small / short / old phone. Sizes come from dimens.xml:
      values/            → conservative (small / short screens)
      values-h640dp/     → normal phone
      values-h900dp/     → tall 19.5:9 phone
      values-sw600dp/    → tablet / unfolded foldable
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh">

    <!-- Gold/red screen tint that fades in while the assistant is listening
         or speaking. Sibling of the content, so it never eats touches. -->
    <View
        android:id="@+id/redOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/overlay_red" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Top bar: battery / RAM · title · clock + settings ── -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/topbar_padding_side"
            android:paddingTop="@dimen/topbar_padding_top"
            android:paddingEnd="@dimen/topbar_padding_side">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/battery"
                        android:src="@drawable/ic_battery" />

                    <TextView
                        android:id="@+id/batteryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="monospace"
                        android:text="@string/dash"
                        android:textColor="@color/accent_red"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ramText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="@string/ram_dash"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/accent_red"
                    android:textSize="@dimen/title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.3"
                    android:text="@string/app_subtitle_caps"
                    android:textColor="@color/text_hint"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/time_placeholder"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/settingsBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Orb: takes whatever vertical space is left ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <com.fawads.ai.ui.main.OrbAnimationView
                    android:id="@+id/orbView"
                    android:layout_width="@dimen/orb_size"
                    android:layout_height="@dimen/orb_size" />

                <com.fawads.ai.ui.main.WaveformView
                    android:id="@+id/waveformView"
                    android:layout_width="@dimen/waveform_width"
                    android:layout_height="@dimen/waveform_height"
                    android:layout_marginTop="@dimen/waveform_overlap" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/status_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/status_size" />
            </LinearLayout>
        </FrameLayout>

        <!-- ── Bottom: chat log + mic ── -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/bottom_padding">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecycler"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chat_height"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="@dimen/mic_button_size"
                    android:layout_height="@dimen/mic_button_size"
                    android:background="@drawable/bg_mic_button"
                    android:contentDescription="@string/microphone"
                    android:padding="@dimen/mic_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic_off" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/mic_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
