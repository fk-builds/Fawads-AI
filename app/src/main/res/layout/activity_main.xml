<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <View
        android:id="@+id/redOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/overlay_red" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_logo_tile"
                android:clipToOutline="true"
                android:contentDescription="FWD app logo"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/fwd_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fawad's AI"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Good morning"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Menu and settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/gold_dark" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- HOME -->
            <ScrollView
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Good morning, Fawad"
                        android:textColor="@color/text_hint"
                        android:textSize="13sp"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="How can I help\nyou today?"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/bg_home_hero"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="YOUR PERSONAL ASSISTANT"
                                    android:textColor="@color/gold_light"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="11dp"
                                    android:text="Just say it,\nand I'll help."
                                    android:textColor="@color/hero_text"
                                    android:textSize="21sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_hero_icon"
                                android:contentDescription="FWD logo"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/fwd_logo" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Open apps, make calls, take notes, and set reminders — by voice."
                            android:textColor="@color/hero_muted"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/startTalkingButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/bg_gold_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Start talking   ›"
                            android:textColor="@color/hero_button_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tools"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/homeSeeAllButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="See all"
                            android:textColor="@color/gold_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/talkActionButton"
                            android:layout_width="0dp"
                            android:layout_height="112dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_feature_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="13dp">

                            <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_feature_icon" android:gravity="center" android:text="◉" android:textColor="@color/gold_dark" android:textSize="20sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Voice Assistant" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Natural responses" android:textColor="@color/text_hint" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/callsToolButton"
                            android:layout_width="0dp"
                            android:layout_height="112dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_feature_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="13dp">

                            <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_feature_icon" android:gravity="center" android:text="☎" android:textColor="@color/gold_dark" android:textSize="18sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Calls &amp; Messages" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Contacts &amp; WhatsApp" android:textColor="@color/text_hint" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/homeNewTaskButton"
                            android:layout_width="0dp"
                            android:layout_height="112dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_feature_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="13dp">

                            <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_feature_icon" android:gravity="center" android:text="✎" android:textColor="@color/gold_dark" android:textSize="20sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Notes &amp; Tasks" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:id="@+id/homeTasksSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="To-dos &amp; reminders" android:textColor="@color/text_hint" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/liveInfoButton"
                            android:layout_width="0dp"
                            android:layout_height="112dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_feature_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="13dp">

                            <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_feature_icon" android:gravity="center" android:text="☼" android:textColor="@color/gold_dark" android:textSize="20sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Live Info" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Weather &amp; news" android:textColor="@color/text_hint" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="Quick Actions"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/actionAlarm" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginEnd="7dp" android:background="@drawable/bg_chip_active" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="Alarm" android:textColor="@color/gold_dark" android:textSize="12sp" />
                        <TextView android:id="@+id/actionWork" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginEnd="7dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="Work" android:textColor="@color/text_hint" android:textSize="12sp" />
                        <TextView android:id="@+id/actionWeather" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginEnd="7dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="Weather" android:textColor="@color/text_hint" android:textSize="12sp" />
                        <TextView android:id="@+id/actionNews" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="News" android:textColor="@color/text_hint" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Device" android:textColor="@color/text_hint" android:textSize="11sp" />
                        <TextView android:id="@+id/batteryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Battery --%" android:textColor="@color/text_hint" android:textSize="11sp" />
                        <TextView android:id="@+id/ramText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="RAM --" android:textColor="@color/text_hint" android:textSize="11sp" />
                        <TextView android:id="@+id/timeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="--:--" android:textColor="@color/text_hint" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- TASKS -->
            <LinearLayout
                android:id="@+id/tasksContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tasks &amp; reminders" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:id="@+id/tasksSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your saved tasks appear here." android:textColor="@color/text_hint" android:textSize="13sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:orientation="horizontal">
                    <TextView android:id="@+id/tasksAddButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_gold_pill" android:clickable="true" android:focusable="true" android:gravity="center" android:text="+  Add task" android:textColor="@color/hero_button_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tasksNotesButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_input_field" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Open notes" android:textColor="@color/gold_dark" android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="13dp" android:layout_weight="1">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/tasksRecycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="8dp" />
                    <TextView android:id="@+id/tasksEmptyText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="28dp" android:text="No tasks yet. Add one here, or ask Voice to set a reminder." android:textColor="@color/text_hint" android:textSize="15sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- VOICE -->
            <ScrollView
                android:id="@+id/assistantContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/voice_bg"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/backHomeButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_voice_control" android:clickable="true" android:focusable="true" android:gravity="center" android:text="‹" android:textColor="@color/gold_light" android:textSize="30sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Voice" android:textColor="@color/hero_text" android:textSize="17sp" android:textStyle="bold" />
                        <ImageButton android:id="@+id/voiceSettingsButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_voice_control" android:contentDescription="Menu and settings" android:padding="10dp" android:src="@drawable/ic_settings" android:tint="@color/gold_light" />
                    </LinearLayout>

                    <FrameLayout android:layout_width="190dp" android:layout_height="190dp" android:layout_marginTop="25dp">
                        <com.fawads.ai.ui.main.OrbAnimationView android:id="@+id/orbView" android:layout_width="match_parent" android:layout_height="match_parent" />
                        <ImageView android:layout_width="148dp" android:layout_height="148dp" android:layout_gravity="center" android:background="@drawable/bg_voice_avatar" android:clipToOutline="true" android:contentDescription="Fawad's photo" android:padding="4dp" android:scaleType="centerCrop" android:src="@drawable/fawad_avatar" />
                    </FrameLayout>

                    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:letterSpacing="0.12" android:text="READY TO LISTEN" android:textAllCaps="true" android:textColor="@color/voice_muted" android:textSize="12sp" />
                    <com.fawads.ai.ui.main.WaveformView android:id="@+id/waveformView" android:layout_width="160dp" android:layout_height="34dp" android:layout_marginTop="7dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Your assistant is here.\nTap the microphone when you're ready."
                        android:textColor="@color/hero_text" android:textSize="16sp" android:lineSpacingExtra="5dp" />

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:gravity="center" android:orientation="horizontal">
                        <TextView android:id="@+id/voicePauseButton" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_voice_control" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Ⅱ" android:textColor="@color/voice_button_text" android:textSize="20sp" />
                        <ImageButton android:id="@+id/micButton" android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_mic_button" android:contentDescription="Mute or unmute microphone" android:src="@drawable/ic_mic_off" android:tint="@color/hero_button_text" />
                        <TextView android:id="@+id/voiceEndButton" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="12dp" android:background="@drawable/bg_voice_control" android:clickable="true" android:focusable="true" android:gravity="center" android:text="×" android:textColor="@color/voice_button_text" android:textSize="25sp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="Voice uses your saved Gemini API key. Audio pauses when you leave this page." android:textColor="@color/voice_muted" android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>

            <!-- CHAT -->
            <LinearLayout
                android:id="@+id/chatContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_dark"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smart Chat" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:id="@+id/chatStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Fawad's AI" android:textColor="@color/text_hint" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/chatClearButton" android:layout_width="60dp" android:layout_height="40dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Clear" android:textColor="@color/gold_dark" android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_chat_input" android:gravity="center_vertical" android:orientation="horizontal" android:padding="5dp">
                    <EditText android:id="@+id/chatInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:gravity="center_vertical" android:hint="Type a message…" android:imeOptions="actionSend" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:minHeight="46dp" android:paddingStart="11dp" android:paddingTop="8dp" android:paddingEnd="10dp" android:paddingBottom="8dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp" />
                    <TextView android:id="@+id/chatSendButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_gold_pill" android:clickable="true" android:contentDescription="Send message" android:focusable="true" android:gravity="center" android:text="➤" android:textColor="@color/hero_button_text" android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@color/card_bg"
            android:elevation="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView android:id="@+id/homeNav" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:clickable="true" android:contentDescription="Home page" android:focusable="true" android:gravity="center" android:text="⌂" android:textColor="@color/nav_inactive" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/tasksNav" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:clickable="true" android:contentDescription="Tasks page" android:focusable="true" android:gravity="center" android:text="✦" android:textColor="@color/nav_inactive" android:textSize="22sp" />
            <TextView android:id="@+id/voiceNav" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:clickable="true" android:contentDescription="Voice assistant page" android:focusable="true" android:gravity="center" android:text="◉" android:textColor="@color/nav_inactive" android:textSize="22sp" />
            <TextView android:id="@+id/chatNav" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:clickable="true" android:contentDescription="Chat page" android:focusable="true" android:gravity="center" android:text="▢" android:textColor="@color/nav_inactive" android:textSize="23sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
