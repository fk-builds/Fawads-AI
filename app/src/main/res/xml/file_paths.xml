<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the in-app updater may expose to the system package installer.
     Everything lives in the app-private dirs, so no runtime storage permission
     is needed and it works the same on every OEM file layout. -->
<paths>
    <external-files-path name="updates" path="." />
    <external-cache-path name="ext_cache" path="." />
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
